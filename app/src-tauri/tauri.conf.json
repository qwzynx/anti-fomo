{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anti-FOMO",
  "version": "0.2.3",
  "identifier": "dev.qwzynx.antifomo",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "Anti-FOMO",
        "width": 1200,
        "height": 840,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "script-src": "'self' 'unsafe-inline'",
        "font-src": "'self'",
        "connect-src": "'self' ipc: http://ipc.localhost",
        "img-src": "'self' data: https://www.google.com"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Education",
    "shortDescription": "Your internships, tech news and events in one ranked feed",
    "longDescription": "Anti-FOMO scrapes job boards, employer career pages, tech news and student events directly on your device, ranks them against your field, skills and interests, and keeps everything in one local feed. Search every posting's full text, save searches, track your applications, and tailor a one-page résumé to any role. No account and no server: your data stays on your machine.",
    "publisher": "qwzynx",
    "copyright": "© 2026 qwzynx",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "linux": {
      "deb": {
        "depends": ["libwebkit2gtk-4.1-0", "libgtk-3-0"]
      }
    }
  }
}
